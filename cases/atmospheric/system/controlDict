FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

// Foundation v14 module. buoyantFoam only forwards to this solver.
solver          fluid;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         360;
deltaT          2;

writeControl    runTime;
writeInterval   120;
purgeWrite      0;

writeFormat     ascii;
writePrecision  8;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable true;
