FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties;
}

// Shallow atmosphere. T in this case stores potential temperature.
// beta = 1/T0. Density only responds to that temperature difference.
thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          eConst;
    equationOfState Boussinesq;
    specie          specie;
    energy          sensibleInternalEnergy;
}

mixture
{
    specie
    {
        molWeight       28.96;
    }
    equationOfState
    {
        rho0            1.2;
        T0              290;
        beta            3.448e-03;
    }
    thermodynamics
    {
        Cv              717;
        Hf              0;
    }
    transport
    {
        mu              1.8e-05;
        Pr              0.7;
    }
}
